{
  "name": "format-inspector-lite",
  "version": "0.1.0",
  "description": "Offline, dependency-free CSV/JSONL format auditing with privacy-minimized reports",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./http": {
      "types": "./src/http.d.ts",
      "import": "./src/http.js",
      "default": "./src/http.js"
    },
    "./report": {
      "types": "./src/report.d.ts",
      "import": "./src/report.js",
      "default": "./src/report.js"
    },
    "./detect": {
      "types": "./src/detect.d.ts",
      "import": "./src/detect.js",
      "default": "./src/detect.js"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "bin": {
    "format-inspector-lite": "bin/cli.js"
  },
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepstriker88/format-inspector-lite.git"
  },
  "homepage": "https://github.com/deepstriker88/format-inspector-lite#readme",
  "bugs": {
    "url": "https://github.com/deepstriker88/format-inspector-lite/issues"
  },
  "keywords": [
    "csv-validation",
    "jsonl",
    "format-validation",
    "data-quality",
    "offline",
    "privacy",
    "cli",
    "email-validation",
    "url-validation"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
